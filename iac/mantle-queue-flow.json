{
  "Version": "2019-10-30",
  "StartAction": "queue-voice",
  "Metadata": {
    "entryPointPosition": {
      "x": 20,
      "y": 20
    },
    "snapToGrid": false,
    "name": "FSI Mantle Customer Queue",
    "type": "contactFlow",
    "status": "published",
    "ActionMetadata": {}
  },
  "Actions": [
    {
      "Identifier": "queue-voice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": {
        "TextToSpeechVoice": "SUDA",
        "TextToSpeechEngine": "connect:agentic"
      },
      "Transitions": {
        "NextAction": "queue-hold-loop",
        "Errors": [
          {
            "NextAction": "queue-hold-loop",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "queue-hold-loop",
      "Type": "MessageParticipantIteratively",
      "Parameters": {
        "InterruptFrequencySeconds": "60",
        "Messages": [
          {
            "Text": "กรุณาถือสายรอสักครู่นะคะ ระบบกำลังโอนสายให้เจ้าหน้าที่ดูแลต่อค่ะ"
          },
          {
            "PromptId": "${HoldPromptArn}"
          }
        ]
      },
      "Transitions": {
        "Errors": [],
        "Conditions": [
          {
            "NextAction": "queue-callback-number",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "MessagesInterrupted"
              ]
            }
          }
        ]
      }
    },
    {
      "Identifier": "queue-callback-number",
      "Type": "UpdateContactCallbackNumber",
      "Parameters": {
        "CallbackNumber": "$.CustomerEndpoint.Address"
      },
      "Transitions": {
        "NextAction": "queue-create-callback",
        "Errors": [
          {
            "NextAction": "queue-no-callback",
            "ErrorType": "InvalidCallbackNumber"
          },
          {
            "NextAction": "queue-no-callback",
            "ErrorType": "CallbackNumberNotDialable"
          }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "queue-create-callback",
      "Type": "CreateCallbackContact",
      "Parameters": {
        "InitialCallDelaySeconds": "30",
        "MaximumConnectionAttempts": "1",
        "RetryDelaySeconds": "600"
      },
      "Transitions": {
        "NextAction": "queue-callback-made",
        "Errors": [
          {
            "NextAction": "queue-no-callback",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "queue-callback-made",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "ขออภัยค่ะ ขณะนี้ยังไม่มีเจ้าหน้าที่ว่างรับสาย ระบบได้นัดให้เจ้าหน้าที่โทรกลับเบอร์นี้แล้วค่ะ ขอบคุณค่ะ"
      },
      "Transitions": {
        "NextAction": "queue-end",
        "Errors": [
          {
            "NextAction": "queue-end",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "queue-no-callback",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "ขออภัยค่ะ ขณะนี้ยังไม่มีเจ้าหน้าที่ว่างรับสาย รบกวนติดต่อกลับอีกครั้งในภายหลังนะคะ ขอบคุณค่ะ"
      },
      "Transitions": {
        "NextAction": "queue-end",
        "Errors": [
          {
            "NextAction": "queue-end",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "queue-end",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
