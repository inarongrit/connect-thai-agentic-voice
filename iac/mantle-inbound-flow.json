{
  "Version": "2019-10-30",
  "StartAction": "inbound-logging",
  "Metadata": {
    "entryPointPosition": {
      "x": 20,
      "y": 20
    },
    "snapToGrid": false,
    "name": "FSI Mantle Inbound Thai",
    "type": "contactFlow",
    "status": "published",
    "ActionMetadata": {}
  },
  "Actions": [
    {
      "Identifier": "inbound-logging",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": {
        "FlowLoggingBehavior": "Enabled"
      },
      "Transitions": {
        "NextAction": "inbound-analytics",
        "Conditions": [],
        "Errors": []
      }
    },
    {
      "Identifier": "inbound-analytics",
      "Type": "UpdateContactRecordingBehavior",
      "Parameters": {
        "RecordingBehavior": {
          "RecordedParticipants": [
            "Agent",
            "Customer"
          ],
          "IVRRecordingBehavior": "Enabled"
        },
        "AnalyticsBehavior": {
          "Enabled": "True",
          "AnalyticsLanguage": "th-TH",
          "ChannelConfiguration": {
            "Voice": {
              "AnalyticsModes": [
                "PostContact",
                "AutomatedInteraction"
              ]
            }
          }
        }
      },
      "Transitions": {
        "NextAction": "inbound-voice",
        "Conditions": [],
        "Errors": []
      }
    },
    {
      "Identifier": "inbound-voice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": {
        "TextToSpeechVoice": "SUDA",
        "TextToSpeechEngine": "connect:agentic"
      },
      "Transitions": {
        "NextAction": "inbound-language",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-language",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-language",
      "Type": "UpdateContactData",
      "Parameters": {
        "LanguageCode": "th-TH"
      },
      "Transitions": {
        "NextAction": "inbound-scenario",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-scenario",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-scenario",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "scenario": "insurance",
          "customerName": "ผู้ทดลองระบบ",
          "channel": "inbound"
        }
      },
      "Transitions": {
        "NextAction": "inbound-greeting",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-greeting",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-greeting",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "สวัสดีค่ะ ดิฉันสุดา ผู้ช่วยอัตโนมัติสำหรับการสาธิตระบบเสียงภาษาไทยค่ะ การสนทนานี้อาจถูกบันทึกเพื่อพัฒนาคุณภาพบริการ ดิฉันไม่ใช่ตัวแทนที่ได้รับอนุญาต และข้อมูลที่ใช้ตอบเป็นข้อมูลสมมติเพื่อการสาธิตค่ะ"
      },
      "Transitions": {
        "NextAction": "inbound-ask",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-ask",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-ask",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": "สอบถามเรื่องบริการธนาคาร ประกัน หรือหลักทรัพย์ได้เลยค่ะ หากต้องการคุยกับเจ้าหน้าที่ แจ้งได้เลยนะคะ",
        "LexV2Bot": {
          "AliasArn": "${MantleLexAlias.Arn}"
        },
        "LexSessionAttributes": {
          "scenario": "$.Attributes.scenario",
          "customerName": "$.Attributes.customerName",
          "mode": "inbound_kb",
          "mantleState": "{}",
          "x-amz-lex:audio:end-confidence-threshold:*:*": "0.7",
          "x-amz-lex:audio:end-timeout-ms:*:*": "1100",
          "x-amz-lex:audio:start-timeout-ms:*:*": "6000"
        }
      },
      "Transitions": {
        "NextAction": "inbound-route",
        "Errors": [
          {
            "NextAction": "inbound-error",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "inbound-error",
            "ErrorType": "NoMatchingCondition"
          },
          {
            "NextAction": "inbound-error",
            "ErrorType": "InputTimeLimitExceeded"
          }
        ],
        "Conditions": [
          {
            "NextAction": "inbound-route",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "FallbackIntent"
              ]
            }
          },
          {
            "NextAction": "inbound-route",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "MantleDialogue"
              ]
            }
          }
        ]
      }
    },
    {
      "Identifier": "inbound-resume",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": "$.Lex.SessionAttributes.nextPrompt",
        "LexV2Bot": {
          "AliasArn": "${MantleLexAlias.Arn}"
        },
        "LexSessionAttributes": {
          "scenario": "$.Attributes.scenario",
          "customerName": "$.Attributes.customerName",
          "mode": "inbound_kb",
          "mantleState": "$.Lex.SessionAttributes.mantleState",
          "x-amz-lex:audio:end-confidence-threshold:*:*": "0.7",
          "x-amz-lex:audio:end-timeout-ms:*:*": "1100",
          "x-amz-lex:audio:start-timeout-ms:*:*": "6000"
        }
      },
      "Transitions": {
        "NextAction": "inbound-route",
        "Errors": [
          {
            "NextAction": "inbound-error",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "inbound-error",
            "ErrorType": "NoMatchingCondition"
          },
          {
            "NextAction": "inbound-error",
            "ErrorType": "InputTimeLimitExceeded"
          }
        ],
        "Conditions": [
          {
            "NextAction": "inbound-route",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "FallbackIntent"
              ]
            }
          },
          {
            "NextAction": "inbound-route",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "MantleDialogue"
              ]
            }
          }
        ]
      }
    },
    {
      "Identifier": "inbound-route",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Lex.SessionAttributes.done"
      },
      "Transitions": {
        "NextAction": "inbound-resume",
        "Errors": [
          {
            "NextAction": "inbound-resume",
            "ErrorType": "NoMatchingCondition"
          }
        ],
        "Conditions": [
          {
            "NextAction": "inbound-closing",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "true"
              ]
            }
          }
        ]
      }
    },
    {
      "Identifier": "inbound-closing",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.Lex.SessionAttributes.nextPrompt"
      },
      "Transitions": {
        "NextAction": "inbound-record-outcome",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-record-outcome",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-record-outcome",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "${SessionContextFunctionArn}",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "mode": "outcome",
          "scenario": "$.Attributes.scenario",
          "outcomeType": "$.Lex.SessionAttributes.outcomeType",
          "outcomeDetail": "$.Lex.SessionAttributes.outcomeDetail"
        }
      },
      "Transitions": {
        "NextAction": "inbound-handoff-branch",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-handoff-branch",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-handoff-branch",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Lex.SessionAttributes.handoffRequired"
      },
      "Transitions": {
        "NextAction": "inbound-end",
        "Errors": [
          {
            "NextAction": "inbound-end",
            "ErrorType": "NoMatchingCondition"
          }
        ],
        "Conditions": [
          {
            "NextAction": "inbound-handoff-attributes",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "true"
              ]
            }
          }
        ]
      }
    },
    {
      "Identifier": "inbound-handoff-attributes",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "handoffReason": "$.Lex.SessionAttributes.handoffReason",
          "handoffSummary": "$.Lex.SessionAttributes.handoffSummary",
          "outcomeType": "$.Lex.SessionAttributes.outcomeType",
          "outcomeDetail": "$.Lex.SessionAttributes.outcomeDetail"
        }
      },
      "Transitions": {
        "NextAction": "inbound-handoff-hooks",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-handoff-hooks",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-handoff-hooks",
      "Type": "UpdateContactEventHooks",
      "Parameters": {
        "EventHooks": {
          "CustomerQueue": "${MantleQueueFlow.ContactFlowArn}",
          "AgentWhisper": "${MantleAgentWhisperFlow.ContactFlowArn}"
        }
      },
      "Transitions": {
        "NextAction": "inbound-handoff-queue",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-handoff-queue",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-handoff-queue",
      "Type": "UpdateContactTargetQueue",
      "Parameters": {
        "QueueId": "${HandoffQueueArn}"
      },
      "Transitions": {
        "NextAction": "inbound-handoff-hours",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-handoff-fallback",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-handoff-hours",
      "Type": "CheckHoursOfOperation",
      "Parameters": {},
      "Transitions": {
        "NextAction": "inbound-handoff-fallback",
        "Errors": [
          {
            "NextAction": "inbound-handoff-fallback",
            "ErrorType": "NoMatchingError"
          }
        ],
        "Conditions": [
          {
            "NextAction": "inbound-handoff-transfer",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "True"
              ]
            }
          },
          {
            "NextAction": "inbound-handoff-fallback",
            "Condition": {
              "Operator": "Equals",
              "Operands": [
                "False"
              ]
            }
          }
        ]
      }
    },
    {
      "Identifier": "inbound-handoff-transfer",
      "Type": "TransferContactToQueue",
      "Parameters": {},
      "Transitions": {
        "NextAction": "inbound-end",
        "Errors": [
          {
            "NextAction": "inbound-handoff-fallback",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "inbound-handoff-fallback",
            "ErrorType": "QueueAtCapacity"
          }
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "inbound-handoff-fallback",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "ขณะนี้ยังไม่มีเจ้าหน้าที่ว่างรับสายค่ะ จะให้เจ้าหน้าที่ติดต่อกลับโดยเร็วที่สุด ขอบคุณค่ะ"
      },
      "Transitions": {
        "NextAction": "inbound-end",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-end",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-error",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "ขออภัยค่ะ ระบบสาธิตยังไม่พร้อมให้บริการ กรุณาลองใหม่ภายหลังค่ะ"
      },
      "Transitions": {
        "NextAction": "inbound-end",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "inbound-end",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "inbound-end",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
